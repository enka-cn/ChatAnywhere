{
  "module": {
    "name": "chat",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "ChatAbility",
    "deviceTypes": [
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.VIBRATE"
      }
    ],
    "abilities": [
      {
        "name": "ChatAbility",
        "srcEntry": "./ets/chatability/ChatAbility.ets",
        "description": "$string:ChatAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:ChatAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "type": "text/plain"
              },
              {
                "type": "text/html"
              },
              {
                "type": "application/pdf"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "ChatBackupAbility",
        "srcEntry": "./ets/chatbackupability/ChatBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}
